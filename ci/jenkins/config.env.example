# Copy to ci/jenkins/config.env and fill in for YOUR infrastructure. That file is gitignored:
# this repo is public, so no host, user or key path belongs in git.
#
#   cp ci/jenkins/config.env.example ci/jenkins/config.env && $EDITOR ci/jenkins/config.env
#
# Every value can also be supplied as an environment variable (what a Jenkins job should do).
# Precedence: environment > config.env > the placeholder defaults (which fail loudly).

# --- build server -------------------------------------------------------------------------
# Anything ssh(1) can reach: a Host alias from ~/.ssh/config, or user@host. Jenkins + Docker live
# here; all compilation happens here (a dev laptop is too weak for the toolchain image).
BUILDER="builder"
# Path on the build server holding the synced working tree.
DEST="jka-src"

# --- test/app server ----------------------------------------------------------------------
# Where deploy-test.sh ships the image. user@host or an ssh alias, reachable FROM the build server
# (deploy-test.sh runs there in a Jenkins job).
TEST_HOST="user@test-host.example"
# Key the BUILD SERVER uses to reach the test server. In a Jenkins job this is a key that lives on
# the builder (e.g. /var/jenkins_home/.ssh/<deploy-key>), never in git.
SSH_KEY="$HOME/.ssh/your-deploy-key"
# Published host port for the jka-test container (its nginx listens on :80 inside). The ingress in
# front routes jka.dev.virtastic.app -> TEST_HOST:PORT. (ja2=8081, jk2=8082, jka=8083.)
PORT="8083"

# --- the deployed origin ------------------------------------------------------------------
# Public URL the smoke test runs against after deploy (TLS + ingress only exist at the real origin).
# Empty skips the public smoke and checks the container directly on TEST_HOST:PORT instead.
SMOKE_URL="https://jka.dev.virtastic.app"
